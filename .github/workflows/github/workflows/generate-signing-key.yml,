name: Generate Permanent Android Signing Key (Run Once)

on:
  workflow_dispatch:

jobs:
  create-keystore:
    runs-on: ubuntu-latest
    steps:
      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Generate Aetheria Continuum UK Release Keystore
        run: |
          keytool -genkeypair -v \
            -keystore offgrid-release.jks \
            -keyalg RSA -keysize 2048 -validity 10000 \
            -alias offgridcomms \
            -storepass OffGrid2026Store! \
            -keypass OffGrid2026Store! \
            -dname "CN=Aetheria Continuum UK, OU=Mobile Engineering, O=Aetheria Continuum, L=Cambridge, ST=Cambridgeshire, C=GB"
          base64 -w 0 offgrid-release.jks > SIGNING_KEY.txt

      - name: Upload Keystore & Base64 Secret
        uses: actions/upload-artifact@v4
        with:
          name: OffGrid-Release-Keystore-SAVE-SAFELY
          path: |
            offgrid-release.jks
            SIGNING_KEY.txt
